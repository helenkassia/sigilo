# Copie para .env e troque os valores.
REDIS_PASSWORD=troque-isto-por-algo-longo-e-aleatorio

# Token exigido para aprovar rotação de chave de um usuário.
# Deve ser entregue fora de banda (não pelo próprio chat).
ROTATION_TOKEN=troque-isto-tambem

# Código do grupo: quem o informa na entrada também entra na sala geral.
# Sem o código, a pessoa só usa conversas diretas (1:1).
# Compartilhe só com quem deve ver a sala geral.
GROUP_TOKEN=troque-pelo-codigo-do-grupo

# --- Prazo das mensagens --------------------------------------------------
# Aceitam s (segundos), m (minutos), h (horas), d (dias).
# Um número sem unidade é lido como segundos.
#
# O prazo é contado da CRIAÇÃO da mensagem. Ler não destrói e não encurta;
# deixar sem ler não prolonga.

MSG_TTL=1d
# Limites que o remetente não pode furar.
MSG_TTL_MIN=30s
MSG_TTL_MAX=7d
# Opções oferecidas no seletor da interface.
TTL_OPTIONS=5m,1h,8h,1d,3d,7d

# Envelope cifrado: 5 MiB comporta imagem/PDF de até 4 MiB + padding e chaves.
MAX_ENVELOPE_BYTES=5242880

# --- Web Push (opcional) --------------------------------------------------
# Sem estas chaves o app sobe normalmente; o toggle "Avisar no celular"
# fica oculto. Gere com: cd server && npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@suaempresa.com
